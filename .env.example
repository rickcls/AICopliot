# Copy to .env and fill in. NEVER commit .env.
# All variables here are server-only. None are NEXT_PUBLIC_.

# --- Database (matches docker-compose.yml) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_ops_copilot?schema=public"
# Neon only. Non-pooled connection used by `npm run db:migrate`.
# Leave unset for local Docker. On Vercel, DATABASE_URL is the pooled host
# and this is the direct host.
# DIRECT_URL="postgresql://user:pass@ep-example.region.aws.neon.tech/neondb?sslmode=require"

# --- Auth.js ---
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-32-byte-base64-secret"
AUTH_URL="http://localhost:3000"

# --- Model provider (OpenRouter) ---
# The only real secret you need. Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY="sk-or-v1-replace-me"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_CHAT_MODEL="anthropic/claude-haiku-4.5"
OPENROUTER_EMBEDDING_MODEL="openai/text-embedding-3-small"

# Must match the vector(N) column in prisma/migrations/.../migration.sql.
# Changing this requires a new migration AND re-embedding every chunk.
EMBEDDING_DIMENSIONS="1536"

# --- Uploads / storage ---
# Local disk. Ignored when BLOB_READ_WRITE_TOKEN is set.
STORAGE_DIR="./storage"
# Vercel Blob read-write token. Unset keeps files on local disk.
# Create a Blob store in the Vercel project and this is injected there.
# BLOB_READ_WRITE_TOKEN=""
MAX_UPLOAD_BYTES="10485760"

# --- Retrieval tuning ---
RAG_TOP_K="8"
# Minimum semantic cosine similarity. A full-text match is also valid evidence;
# without either kind of evidence, refuse without calling the LLM.
RAG_MIN_SCORE="0.25"
