// ScopePilot — AI Project Delivery Copilot data model.
//
// Isolation rule: every application table below carries `workspaceId`, and every
// query must filter on it. Single-record reads use findFirst({ where: { id, workspaceId } })
// rather than findUnique({ where: { id } }) so a leaked ID from another workspace
// cannot resolve. See src/lib/auth-guard.ts.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Prisma 7: the connection URL lives in prisma.config.ts, not here.
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Auth.js v5 tables. Identity lives here and nowhere else; application tables
// reference User.id only and never duplicate credentials.
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  // Credentials provider has no password store of its own, so the bcrypt hash
  // lives on the Auth.js user row. Never selected into any client payload.
  passwordHash  String?
  createdAt     DateTime  @default(now())

  accounts                 Account[]
  ownedWorkspaces          Workspace[]
  memberships              WorkspaceMember[]
  conversations            ChatConversation[]
  feedback                 AnswerFeedback[]
  assignedTasks            Task[]             @relation("TaskAssignee")
  generationRuns           GenerationRun[]
  reviewedTasks            Task[]             @relation("TaskReviewer")
  reviewedMilestones       Milestone[]        @relation("MilestoneReviewer")
  reviewedRisks            ProjectRisk[]      @relation("RiskReviewer")
  reviewedTaskDependencies TaskDependency[]   @relation("TaskDependencyReviewer")
  reviewedRequirements     Requirement[]      @relation("RequirementReviewer")
  createdRequirementLinks  RequirementLink[]  @relation("RequirementLinkCreator")
  taskComments             TaskComment[]      @relation("TaskCommentAuthor")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

// ---------------------------------------------------------------------------
// Workspaces
// ---------------------------------------------------------------------------

enum WorkspaceRole {
  admin
  member
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  createdAt DateTime @default(now())

  owner         User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members       WorkspaceMember[]
  projects      Project[]
  documents     Document[]
  chunks        DocumentChunk[]
  conversations ChatConversation[]
  evaluations   EvaluationCase[]

  tasks                   Task[]
  taskDependencies        TaskDependency[]
  taskStatuses            ProjectTaskStatus[]
  milestones              Milestone[]
  risks                   ProjectRisk[]
  requirements            Requirement[]
  requirementCitations    RequirementCitation[]
  requirementLinks        RequirementLink[]
  taskCitations           TaskCitation[]
  milestoneCitations      MilestoneCitation[]
  riskCitations           RiskCitation[]
  taskDependencyCitations TaskDependencyCitation[]
  generationRuns          GenerationRun[]
  taskComments            TaskComment[]

  @@index([ownerId])
}

model Project {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace     Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  documents     Document[]
  conversations ChatConversation[]
  evaluations   EvaluationCase[]

  // Documents, conversations, and evaluations SET NULL on project delete because
  // they remain meaningful unassigned. The records below cannot exist without a
  // project (projectId is non-nullable), so they cascade instead.
  tasks          Task[]
  taskStatuses   ProjectTaskStatus[]
  milestones     Milestone[]
  risks          ProjectRisk[]
  requirements   Requirement[]
  generationRuns GenerationRun[]

  @@unique([workspaceId, name])
  @@index([workspaceId, createdAt])
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(member)
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Documents & chunks
// ---------------------------------------------------------------------------

enum DocumentStatus {
  uploaded
  processing
  ready
  failed
}

model Document {
  id               String         @id @default(cuid())
  workspaceId      String
  projectId        String?
  originalFilename String
  mimeType         String
  sizeBytes        Int
  storageKey       String
  status           DocumentStatus @default(uploaded)
  errorMessage     String?
  // Cached plain text for the document detail preview; avoids re-parsing the
  // original file just to show an excerpt.
  extractedText    String?
  chunkCount       Int            @default(0)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  chunks    DocumentChunk[]

  @@index([workspaceId, status])
  @@index([workspaceId, createdAt])
  @@index([workspaceId, projectId])
}

model DocumentChunk {
  id           String                       @id @default(cuid())
  documentId   String
  workspaceId  String
  content      String
  chunkIndex   Int
  pageNumber   Int?
  sectionTitle String?
  // pgvector. Prisma intentionally omits Unsupported() fields from the generated
  // client, so reads/writes of this column go through $queryRaw/$executeRaw in
  // src/lib/rag/retrieve.ts and src/lib/ingest/pipeline.ts.
  // The dimension must equal EMBEDDING_DIMENSIONS.
  embedding    Unsupported("vector(1536)")?
  createdAt    DateTime                     @default(now())

  document  Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  taskCitations           TaskCitation[]
  milestoneCitations      MilestoneCitation[]
  riskCitations           RiskCitation[]
  taskDependencyCitations TaskDependencyCitation[]
  requirementCitations    RequirementCitation[]

  @@unique([documentId, chunkIndex])
  @@index([workspaceId])
  @@index([documentId])
}

// ---------------------------------------------------------------------------
// Chat
// ---------------------------------------------------------------------------

enum MessageRole {
  user
  assistant
}

enum AnswerConfidence {
  high
  medium
  low
}

enum GroundingScope {
  documents
  project_combined
}

model ChatConversation {
  id             String         @id @default(cuid())
  workspaceId    String
  projectId      String?
  userId         String
  title          String
  groundingScope GroundingScope @default(documents)
  createdAt      DateTime       @default(now())

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]

  @@index([workspaceId, userId])
}

model ChatMessage {
  id                 String            @id @default(cuid())
  conversationId     String
  role               MessageRole
  content            String
  citations          Json?
  confidence         AnswerConfidence?
  latencyMs          Int?
  // Observability (approved addition to the original spec): lets us inspect
  // which chunks fed an answer and which model produced it.
  modelName          String?
  retrievedChunkIds  Json?
  groundingSourceIds Json?
  createdAt          DateTime          @default(now())

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  feedback     AnswerFeedback[]

  @@index([conversationId, createdAt])
}

enum FeedbackRating {
  up
  down
}

model AnswerFeedback {
  id            String         @id @default(cuid())
  chatMessageId String
  userId        String
  rating        FeedbackRating
  comment       String?
  createdAt     DateTime       @default(now())

  chatMessage ChatMessage @relation(fields: [chatMessageId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([chatMessageId, userId])
}

// ---------------------------------------------------------------------------
// Evaluations
// ---------------------------------------------------------------------------

enum EvaluationResult {
  pass
  fail
  unreviewed
}

model EvaluationCase {
  id                  String            @id @default(cuid())
  workspaceId         String
  projectId           String?
  question            String
  groundingScope      GroundingScope    @default(documents)
  expectedAnswerNotes String?
  // Golden-set expectations, used for deterministic auto-scoring. Keeping these
  // machine-checkable is what lets the whole suite be re-run as a regression.
  expectedKeywords    String[]          @default([])
  shouldRefuse        Boolean           @default(false)
  actualAnswer        String?
  retrievedChunkIds   Json?
  confidence          AnswerConfidence?
  latencyMs           Int?
  modelName           String?
  citationCount       Int               @default(0)
  /// Whether the last run refused. Recorded rather than inferred from the
  /// answer text or citation count, both of which are fragile proxies.
  refused             Boolean           @default(false)
  /// Set by scoreEvaluation(); null when the case needs human judgement.
  autoScore           Boolean?
  result              EvaluationResult  @default(unreviewed)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @default(now()) @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([workspaceId, projectId])
}

// ---------------------------------------------------------------------------
// Project management
//
// Tasks, milestones, and risks are project-owned: projectId is NOT nullable, so
// unlike documents they cannot survive their project and cascade on delete.
//
// `source`, `generationStatus`, and generation-run audit fields distinguish
// manual official records from AI proposals. Draft/rejected AI records are
// review-only; operational reads admit only approved AI records.
// ---------------------------------------------------------------------------

/// Semantic role of a project task column. Labels and keys are per-project;
/// category is what overdue, completion timestamps, blockers, and reports key off.
enum TaskStatusCategory {
  open
  blocked
  done
}

enum TaskPriority {
  low
  medium
  high
  urgent
}

/// A board/list column for one project. Seeded with the classic five on create;
/// users may add, rename, or remove columns as long as at least one `open` and
/// one `done` remain. Tasks point here by id — never at a global enum.
model ProjectTaskStatus {
  id          String             @id @default(cuid())
  workspaceId String
  projectId   String
  /// Stable slug unique within the project. Defaults reuse backlog/todo/… so
  /// plan generation can still map model output by key; custom rows get a
  /// slugified label.
  key         String
  label       String
  category    TaskStatusCategory
  position    Int
  /// Optional UI token (`slate`, `blue`, …). Null falls back to the category.
  color       String?
  /// New tasks land here when the client omits a status.
  isDefault   Boolean            @default(false)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@unique([projectId, key])
  @@index([workspaceId, projectId, position])
}

enum MilestoneStatus {
  not_started
  on_track
  at_risk
  blocked
  completed
}

/// Shared by ProjectRisk.impact and ProjectRisk.likelihood — same scale, so one enum.
enum RiskLevel {
  low
  medium
  high
}

enum RiskStatus {
  open
  monitoring
  mitigated
  accepted
}

/// Whether a record was entered by a person or proposed from a document.
enum RecordSource {
  manual
  ai_suggested
}

/// Review state of a proposed record. Manual records are `not_applicable`.
enum GenerationStatus {
  not_applicable
  draft
  approved
  rejected
}

enum CitationPurpose {
  proposal
  milestone_link
}

/// What kind of need a requirement expresses. Drives grouping, not behaviour.
enum RequirementType {
  business
  functional
  non_functional
  constraint
}

/// MoSCoW. `wont` is deliberately recorded rather than deleted: "explicitly out
/// of scope" is an agreement, and losing it invites the same debate twice.
enum RequirementPriority {
  must
  should
  could
  wont
}

/// Discovery lifecycle. Distinct from `generationStatus`, which records whether
/// a human accepted the *record*; this records how settled its *content* is.
/// Only `approved` counts as baselined scope. See src/lib/pm/rules.ts.
enum RequirementStatus {
  draft
  needs_clarification
  validated
  approved
  rejected
}

/// How firmly the source text supports the requirement as written. A vague
/// source ("must be secure") must yield `low` rather than an invented specific.
enum RequirementConfidence {
  high
  medium
  low
}

enum RequirementLinkTarget {
  task
  milestone
  risk
}

model Task {
  id               String           @id @default(cuid())
  workspaceId      String
  projectId        String
  title            String
  description      String?
  statusId         String
  priority         TaskPriority     @default(medium)
  assigneeId       String?
  milestoneId      String?
  estimatedHours   Float?
  // startDate is what makes a Gantt bar meaningful: without it a task has a
  // deadline but no duration, and the chart can only draw a marker.
  startDate        DateTime?
  dueDate          DateTime?
  completedAt      DateTime?
  source           RecordSource     @default(manual)
  generationStatus GenerationStatus @default(not_applicable)
  generationRunId  String?
  reviewedAt       DateTime?
  reviewedById     String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  workspace     Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project       Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status        ProjectTaskStatus  @relation(fields: [statusId], references: [id], onDelete: Restrict)
  // Removing a person unassigns their work rather than deleting it.
  assignee      User?              @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  milestone     Milestone?         @relation("TaskMilestone", fields: [milestoneId], references: [id], onDelete: SetNull)
  generationRun GenerationRun?     @relation(fields: [generationRunId], references: [id], onDelete: SetNull)
  reviewedBy    User?              @relation("TaskReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  dependencies     TaskDependency[]  @relation("DependentTask")
  dependents       TaskDependency[]  @relation("DependencyTask")
  citations        TaskCitation[]
  requirementLinks RequirementLink[]
  comments         TaskComment[]

  @@index([workspaceId, projectId, statusId])
  @@index([workspaceId, dueDate])
  @@index([workspaceId, startDate])
  @@index([workspaceId, completedAt])
  @@index([workspaceId, projectId, milestoneId])
  @@index([generationRunId])
  @@index([reviewedById])
  @@index([assigneeId])
  @@index([statusId])
}

/// Human discussion on a task.
///
/// Deliberately outside the source/generationStatus model the delivery records
/// share: a comment is not a proposal awaiting review, so it has no draft state
/// and never enters `officialRecordWhere()`. It is also not grounding evidence —
/// project chat answers from documents and official records, and letting
/// free-text commentary in would put unreviewed opinion behind a citation.
model TaskComment {
  id          String   @id @default(cuid())
  workspaceId String
  taskId      String
  /// Nullable so removing a person leaves the discussion intact rather than
  /// deleting history, matching the assignee rule on Task.
  authorId    String?
  body        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author    User?     @relation("TaskCommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([workspaceId, taskId, createdAt])
  @@index([authorId])
}

model TaskDependency {
  id               String           @id @default(cuid())
  workspaceId      String
  taskId           String
  dependsOnTaskId  String
  source           RecordSource     @default(manual)
  generationStatus GenerationStatus @default(not_applicable)
  generationRunId  String?
  reviewedAt       DateTime?
  reviewedById     String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  workspace     Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  task          Task                     @relation("DependentTask", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOnTask Task                     @relation("DependencyTask", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)
  generationRun GenerationRun?           @relation(fields: [generationRunId], references: [id], onDelete: SetNull)
  reviewedBy    User?                    @relation("TaskDependencyReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  citations     TaskDependencyCitation[]

  // Self-reference is additionally blocked by a CHECK constraint added in the
  // migration; Prisma has no schema syntax for it (same reason the HNSW and GIN
  // indexes are hand-written).
  @@unique([taskId, dependsOnTaskId])
  @@index([workspaceId])
  @@index([dependsOnTaskId])
  @@index([generationRunId])
  @@index([reviewedById])
}

model Milestone {
  id               String           @id @default(cuid())
  workspaceId      String
  projectId        String
  title            String
  description      String?
  targetDate       DateTime?
  status           MilestoneStatus  @default(not_started)
  completedAt      DateTime?
  source           RecordSource     @default(manual)
  generationStatus GenerationStatus @default(not_applicable)
  generationRunId  String?
  reviewedAt       DateTime?
  reviewedById     String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  workspace     Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project       Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  generationRun GenerationRun?      @relation(fields: [generationRunId], references: [id], onDelete: SetNull)
  reviewedBy    User?               @relation("MilestoneReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  citations        MilestoneCitation[]
  tasks            Task[]              @relation("TaskMilestone")
  risks            ProjectRisk[]       @relation("RiskMilestone")
  requirementLinks RequirementLink[]

  @@index([workspaceId, projectId])
  @@index([workspaceId, targetDate])
  @@index([workspaceId, completedAt])
  @@index([generationRunId])
  @@index([reviewedById])
}

model ProjectRisk {
  id               String           @id @default(cuid())
  workspaceId      String
  projectId        String
  milestoneId      String?
  description      String
  impact           RiskLevel        @default(medium)
  likelihood       RiskLevel        @default(medium)
  mitigation       String?
  status           RiskStatus       @default(open)
  source           RecordSource     @default(manual)
  generationStatus GenerationStatus @default(not_applicable)
  generationRunId  String?
  reviewedAt       DateTime?
  reviewedById     String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone     Milestone?     @relation("RiskMilestone", fields: [milestoneId], references: [id], onDelete: SetNull)
  generationRun GenerationRun? @relation(fields: [generationRunId], references: [id], onDelete: SetNull)
  reviewedBy    User?          @relation("RiskReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  citations     RiskCitation[]

  requirementLinks RequirementLink[]

  @@index([workspaceId, projectId, status])
  @@index([workspaceId, projectId, milestoneId])
  @@index([generationRunId])
  @@index([reviewedById])
}

// ---------------------------------------------------------------------------
// Requirement register.
//
// Requirements carry TWO independent status axes, and conflating them loses
// information the register exists to hold:
//
//   source + generationStatus — is this record an unreviewed or rejected AI
//     proposal? Identical to Task/Milestone/ProjectRisk, so officialRecordWhere()
//     and the CHECK constraint apply unchanged.
//   status (RequirementStatus) — is this agreed scope? A manually typed
//     requirement is "official" the moment it is saved but still starts at
//     `draft`, because writing something down is not agreeing it.
//
// Baselined scope is officialRecordWhere(...) AND status = 'approved'. Unlike
// the delivery records, drafts are shown in the register: "we think they asked
// for this, unconfirmed" is the working state a consultant acts on.
// ---------------------------------------------------------------------------

model Requirement {
  id                 String                @id @default(cuid())
  workspaceId        String
  projectId          String
  /// Per-project counter rendered as REQ-007 by formatRequirementCode. Stored as
  /// an integer so it sorts correctly past 999 and the display format stays free.
  sequence           Int
  title              String
  description        String?
  type               RequirementType       @default(functional)
  priority           RequirementPriority   @default(should)
  status             RequirementStatus     @default(draft)
  acceptanceCriteria String?
  assumptions        String?
  confidence         RequirementConfidence @default(medium)
  /// Free text in this phase — the person or role accountable for the answer.
  stakeholder        String?
  source             RecordSource          @default(manual)
  generationStatus   GenerationStatus      @default(not_applicable)
  generationRunId    String?
  reviewedAt         DateTime?
  reviewedById       String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  workspace     Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project       Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  generationRun GenerationRun?        @relation(fields: [generationRunId], references: [id], onDelete: SetNull)
  reviewedBy    User?                 @relation("RequirementReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  citations     RequirementCitation[]
  links         RequirementLink[]

  @@unique([projectId, sequence])
  @@index([workspaceId, projectId, status])
  @@index([workspaceId, projectId, priority])
  @@index([generationRunId])
  @@index([reviewedById])
}

/// Traceability edge from a requirement to a delivery record.
///
/// One table with three nullable foreign keys rather than an opaque `targetId`:
/// a bare id has no referential integrity, so deleting a task would leave a link
/// that coverage queries still count. A CHECK constraint in the migration enforces
/// that exactly one target is set and matches `targetType`.
model RequirementLink {
  id            String                @id @default(cuid())
  workspaceId   String
  requirementId String
  targetType    RequirementLinkTarget
  taskId        String?
  milestoneId   String?
  riskId        String?
  createdById   String?
  createdAt     DateTime              @default(now())

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  requirement Requirement  @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  task        Task?        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  milestone   Milestone?   @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  risk        ProjectRisk? @relation(fields: [riskId], references: [id], onDelete: Cascade)
  createdBy   User?        @relation("RequirementLinkCreator", fields: [createdById], references: [id], onDelete: SetNull)

  // Postgres treats NULLs as distinct, so each constraint only binds rows that
  // actually target that kind of record.
  @@unique([requirementId, taskId])
  @@unique([requirementId, milestoneId])
  @@unique([requirementId, riskId])
  @@index([workspaceId, requirementId])
  @@index([taskId])
  @@index([milestoneId])
  @@index([riskId])
  @@index([createdById])
}

// ---------------------------------------------------------------------------
// Evidence for generated records.
//
// A citation points at the DocumentChunk it was grounded in, so a proposal can
// always be traced back to the source text. Deleting the chunk removes the
// citation: evidence that no longer exists must not be displayed as if it did.
// ---------------------------------------------------------------------------

model TaskCitation {
  id              String          @id @default(cuid())
  workspaceId     String
  taskId          String
  documentChunkId String
  purpose         CitationPurpose @default(proposal)
  excerpt         String?
  createdAt       DateTime        @default(now())

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  task      Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  chunk     DocumentChunk @relation(fields: [documentChunkId], references: [id], onDelete: Cascade)

  @@unique([taskId, documentChunkId, purpose])
  @@index([workspaceId])
  @@index([documentChunkId])
}

model MilestoneCitation {
  id              String   @id @default(cuid())
  workspaceId     String
  milestoneId     String
  documentChunkId String
  excerpt         String?
  createdAt       DateTime @default(now())

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  milestone Milestone     @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  chunk     DocumentChunk @relation(fields: [documentChunkId], references: [id], onDelete: Cascade)

  @@unique([milestoneId, documentChunkId])
  @@index([workspaceId])
  @@index([documentChunkId])
}

model RiskCitation {
  id              String          @id @default(cuid())
  workspaceId     String
  riskId          String
  documentChunkId String
  purpose         CitationPurpose @default(proposal)
  excerpt         String?
  createdAt       DateTime        @default(now())

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  risk      ProjectRisk   @relation(fields: [riskId], references: [id], onDelete: Cascade)
  chunk     DocumentChunk @relation(fields: [documentChunkId], references: [id], onDelete: Cascade)

  @@unique([riskId, documentChunkId, purpose])
  @@index([workspaceId])
  @@index([documentChunkId])
}

model RequirementCitation {
  id              String   @id @default(cuid())
  workspaceId     String
  requirementId   String
  documentChunkId String
  excerpt         String?
  createdAt       DateTime @default(now())

  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  requirement Requirement   @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  chunk       DocumentChunk @relation(fields: [documentChunkId], references: [id], onDelete: Cascade)

  @@unique([requirementId, documentChunkId])
  @@index([workspaceId])
  @@index([documentChunkId])
}

model TaskDependencyCitation {
  id               String   @id @default(cuid())
  workspaceId      String
  taskDependencyId String
  documentChunkId  String
  excerpt          String?
  createdAt        DateTime @default(now())

  workspace      Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  taskDependency TaskDependency @relation(fields: [taskDependencyId], references: [id], onDelete: Cascade)
  chunk          DocumentChunk  @relation(fields: [documentChunkId], references: [id], onDelete: Cascade)

  @@unique([taskDependencyId, documentChunkId])
  @@index([workspaceId])
  @@index([documentChunkId])
}

// ---------------------------------------------------------------------------
// Generation audit trail for cited project-plan proposals and saved status
// reports. Raw provider output is retained even when parsing or validation
// fails, so every user-triggered generation attempt remains inspectable.
// ---------------------------------------------------------------------------

enum GenerationRunType {
  project_plan
  tasks
  status_report
  requirements
}

enum GenerationRunStatus {
  processing
  draft
  approved
  partially_approved
  rejected
  failed
}

model GenerationRun {
  id                 String              @id @default(cuid())
  workspaceId        String
  projectId          String
  type               GenerationRunType
  model              String
  promptVersion      String
  /// Opaque source labels and record IDs that fed the prompt.
  selectedContextIds Json
  /// Text, not Json: unparseable model output must still be recordable for audit.
  rawOutput          String?
  validatedOutput    Json?
  status             GenerationRunStatus @default(draft)
  errorMessage       String?
  latencyMs          Int?
  createdBy          String
  createdAt          DateTime            @default(now())
  approvedAt         DateTime?

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project          Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator          User             @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  tasks            Task[]
  milestones       Milestone[]
  risks            ProjectRisk[]
  taskDependencies TaskDependency[]
  requirements     Requirement[]

  @@index([workspaceId, projectId, createdAt])
}
