// AI Ops Copilot — data model.
//
// Isolation rule: every application table below carries `workspaceId`, and every
// query must filter on it. Single-record reads use findFirst({ where: { id, workspaceId } })
// rather than findUnique({ where: { id } }) so a leaked ID from another workspace
// cannot resolve. See src/lib/auth-guard.ts.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Prisma 7: the connection URL lives in prisma.config.ts, not here.
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Auth.js v5 tables. Identity lives here and nowhere else; application tables
// reference User.id only and never duplicate credentials.
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  // Credentials provider has no password store of its own, so the bcrypt hash
  // lives on the Auth.js user row. Never selected into any client payload.
  passwordHash  String?
  createdAt     DateTime  @default(now())

  accounts         Account[]
  ownedWorkspaces  Workspace[]
  memberships      WorkspaceMember[]
  conversations    ChatConversation[]
  feedback         AnswerFeedback[]
  assignedTasks    Task[]             @relation("TaskAssignee")
  generationRuns   GenerationRun[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

// ---------------------------------------------------------------------------
// Workspaces
// ---------------------------------------------------------------------------

enum WorkspaceRole {
  admin
  member
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  createdAt DateTime @default(now())

  owner       User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members     WorkspaceMember[]
  projects    Project[]
  documents   Document[]
  chunks      DocumentChunk[]
  conversations ChatConversation[]
  evaluations EvaluationCase[]

  tasks              Task[]
  taskDependencies   TaskDependency[]
  milestones         Milestone[]
  risks              ProjectRisk[]
  taskCitations      TaskCitation[]
  milestoneCitations MilestoneCitation[]
  riskCitations      RiskCitation[]
  generationRuns     GenerationRun[]

  @@index([ownerId])
}

model Project {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace     Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  documents     Document[]
  conversations ChatConversation[]
  evaluations   EvaluationCase[]

  // Documents, conversations, and evaluations SET NULL on project delete because
  // they remain meaningful unassigned. The records below cannot exist without a
  // project (projectId is non-nullable), so they cascade instead.
  tasks          Task[]
  milestones     Milestone[]
  risks          ProjectRisk[]
  generationRuns GenerationRun[]

  @@unique([workspaceId, name])
  @@index([workspaceId, createdAt])
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(member)
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Documents & chunks
// ---------------------------------------------------------------------------

enum DocumentStatus {
  uploaded
  processing
  ready
  failed
}

model Document {
  id               String         @id @default(cuid())
  workspaceId      String
  projectId        String?
  originalFilename String
  mimeType         String
  sizeBytes        Int
  storageKey       String
  status           DocumentStatus @default(uploaded)
  errorMessage     String?
  // Cached plain text for the document detail preview; avoids re-parsing the
  // original file just to show an excerpt.
  extractedText    String?
  chunkCount       Int            @default(0)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  chunks    DocumentChunk[]

  @@index([workspaceId, status])
  @@index([workspaceId, createdAt])
  @@index([workspaceId, projectId])
}

model DocumentChunk {
  id           String   @id @default(cuid())
  documentId   String
  workspaceId  String
  content      String
  chunkIndex   Int
  pageNumber   Int?
  sectionTitle String?
  // pgvector. Prisma intentionally omits Unsupported() fields from the generated
  // client, so reads/writes of this column go through $queryRaw/$executeRaw in
  // src/lib/rag/retrieve.ts and src/lib/ingest/pipeline.ts.
  // The dimension must equal EMBEDDING_DIMENSIONS.
  embedding    Unsupported("vector(1536)")?
  createdAt    DateTime @default(now())

  document  Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  taskCitations      TaskCitation[]
  milestoneCitations MilestoneCitation[]
  riskCitations      RiskCitation[]

  @@unique([documentId, chunkIndex])
  @@index([workspaceId])
  @@index([documentId])
}

// ---------------------------------------------------------------------------
// Chat
// ---------------------------------------------------------------------------

enum MessageRole {
  user
  assistant
}

enum AnswerConfidence {
  high
  medium
  low
}

model ChatConversation {
  id          String   @id @default(cuid())
  workspaceId String
  projectId   String?
  userId      String
  title       String
  createdAt   DateTime @default(now())

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]

  @@index([workspaceId, userId])
}

model ChatMessage {
  id             String            @id @default(cuid())
  conversationId String
  role           MessageRole
  content        String
  citations      Json?
  confidence     AnswerConfidence?
  latencyMs      Int?
  // Observability (approved addition to the original spec): lets us inspect
  // which chunks fed an answer and which model produced it.
  modelName          String?
  retrievedChunkIds  Json?
  createdAt      DateTime          @default(now())

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  feedback     AnswerFeedback[]

  @@index([conversationId, createdAt])
}

enum FeedbackRating {
  up
  down
}

model AnswerFeedback {
  id            String         @id @default(cuid())
  chatMessageId String
  userId        String
  rating        FeedbackRating
  comment       String?
  createdAt     DateTime       @default(now())

  chatMessage ChatMessage @relation(fields: [chatMessageId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([chatMessageId, userId])
}

// ---------------------------------------------------------------------------
// Evaluations
// ---------------------------------------------------------------------------

enum EvaluationResult {
  pass
  fail
  unreviewed
}

model EvaluationCase {
  id                  String           @id @default(cuid())
  workspaceId         String
  projectId           String?
  question            String
  expectedAnswerNotes String?
  actualAnswer        String?
  retrievedChunkIds   Json?
  confidence          AnswerConfidence?
  latencyMs           Int?
  modelName           String?
  result              EvaluationResult @default(unreviewed)
  createdAt           DateTime         @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([workspaceId, projectId])
}

// ---------------------------------------------------------------------------
// Project management
//
// Tasks, milestones, and risks are project-owned: projectId is NOT nullable, so
// unlike documents they cannot survive their project and cascade on delete.
//
// `source` and `generationStatus` exist from the first migration so the planned
// document-to-plan generation needs no schema change. Nothing writes anything
// other than `manual` / `not_applicable` yet.
// ---------------------------------------------------------------------------

enum TaskStatus {
  backlog
  todo
  in_progress
  blocked
  done
}

enum TaskPriority {
  low
  medium
  high
  urgent
}

enum MilestoneStatus {
  not_started
  on_track
  at_risk
  blocked
  completed
}

/// Shared by ProjectRisk.impact and ProjectRisk.likelihood — same scale, so one enum.
enum RiskLevel {
  low
  medium
  high
}

enum RiskStatus {
  open
  monitoring
  mitigated
  accepted
}

/// Whether a record was entered by a person or proposed from a document.
enum RecordSource {
  manual
  ai_suggested
}

/// Review state of a proposed record. Manual records are `not_applicable`.
enum GenerationStatus {
  not_applicable
  draft
  approved
  rejected
}

model Task {
  id               String           @id @default(cuid())
  workspaceId      String
  projectId        String
  title            String
  description      String?
  status           TaskStatus       @default(backlog)
  priority         TaskPriority     @default(medium)
  assigneeId       String?
  estimatedHours   Float?
  // startDate is what makes a Gantt bar meaningful: without it a task has a
  // deadline but no duration, and the chart can only draw a marker.
  startDate        DateTime?
  dueDate          DateTime?
  source           RecordSource     @default(manual)
  generationStatus GenerationStatus @default(not_applicable)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // Removing a person unassigns their work rather than deleting it.
  assignee  User?     @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  dependencies TaskDependency[] @relation("DependentTask")
  dependents   TaskDependency[] @relation("DependencyTask")
  citations    TaskCitation[]

  @@index([workspaceId, projectId, status])
  @@index([workspaceId, dueDate])
  @@index([workspaceId, startDate])
  @@index([assigneeId])
}

model TaskDependency {
  id              String   @id @default(cuid())
  workspaceId     String
  taskId          String
  dependsOnTaskId String
  createdAt       DateTime @default(now())

  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  task          Task      @relation("DependentTask", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOnTask Task      @relation("DependencyTask", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)

  // Self-reference is additionally blocked by a CHECK constraint added in the
  // migration; Prisma has no schema syntax for it (same reason the HNSW and GIN
  // indexes are hand-written).
  @@unique([taskId, dependsOnTaskId])
  @@index([workspaceId])
  @@index([dependsOnTaskId])
}

model Milestone {
  id               String           @id @default(cuid())
  workspaceId      String
  projectId        String
  title            String
  description      String?
  targetDate       DateTime?
  status           MilestoneStatus  @default(not_started)
  source           RecordSource     @default(manual)
  generationStatus GenerationStatus @default(not_applicable)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  citations MilestoneCitation[]

  @@index([workspaceId, projectId])
  @@index([workspaceId, targetDate])
}

model ProjectRisk {
  id               String           @id @default(cuid())
  workspaceId      String
  projectId        String
  description      String
  impact           RiskLevel        @default(medium)
  likelihood       RiskLevel        @default(medium)
  mitigation       String?
  status           RiskStatus       @default(open)
  source           RecordSource     @default(manual)
  generationStatus GenerationStatus @default(not_applicable)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  citations RiskCitation[]

  @@index([workspaceId, projectId, status])
}

// ---------------------------------------------------------------------------
// Evidence for generated records.
//
// A citation points at the DocumentChunk it was grounded in, so a proposal can
// always be traced back to the source text. Deleting the chunk removes the
// citation: evidence that no longer exists must not be displayed as if it did.
// ---------------------------------------------------------------------------

model TaskCitation {
  id              String   @id @default(cuid())
  workspaceId     String
  taskId          String
  documentChunkId String
  excerpt         String?
  createdAt       DateTime @default(now())

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  task      Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  chunk     DocumentChunk @relation(fields: [documentChunkId], references: [id], onDelete: Cascade)

  @@unique([taskId, documentChunkId])
  @@index([workspaceId])
  @@index([documentChunkId])
}

model MilestoneCitation {
  id              String   @id @default(cuid())
  workspaceId     String
  milestoneId     String
  documentChunkId String
  excerpt         String?
  createdAt       DateTime @default(now())

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  milestone Milestone     @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  chunk     DocumentChunk @relation(fields: [documentChunkId], references: [id], onDelete: Cascade)

  @@unique([milestoneId, documentChunkId])
  @@index([workspaceId])
  @@index([documentChunkId])
}

model RiskCitation {
  id              String   @id @default(cuid())
  workspaceId     String
  riskId          String
  documentChunkId String
  excerpt         String?
  createdAt       DateTime @default(now())

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  risk      ProjectRisk   @relation(fields: [riskId], references: [id], onDelete: Cascade)
  chunk     DocumentChunk @relation(fields: [documentChunkId], references: [id], onDelete: Cascade)

  @@unique([riskId, documentChunkId])
  @@index([workspaceId])
  @@index([documentChunkId])
}

// ---------------------------------------------------------------------------
// Generation audit trail. Reserved for the planned document-to-plan workflow;
// no code writes to it in this phase.
// ---------------------------------------------------------------------------

enum GenerationRunType {
  project_plan
  tasks
  status_report
}

enum GenerationRunStatus {
  draft
  approved
  partially_approved
  rejected
  failed
}

model GenerationRun {
  id          String            @id @default(cuid())
  workspaceId String
  projectId   String
  type        GenerationRunType
  model       String
  promptVersion String
  /// Opaque source labels and record IDs that fed the prompt.
  selectedContextIds Json
  /// Text, not Json: unparseable model output must still be recordable for audit.
  rawOutput       String?
  validatedOutput Json?
  status          GenerationRunStatus @default(draft)
  createdBy       String
  createdAt       DateTime            @default(now())
  approvedAt      DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator   User      @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([workspaceId, projectId, createdAt])
}
